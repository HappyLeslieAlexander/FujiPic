# Copy to /etc/fujipic/fujipic.env; chmod 600. Never commit real credentials.
# Replace with your actual hostnames. No scheme, path or port here.
APP_HOST=pic.lesliealexander.eu
IMAGE_HOST=img.lesliealexander.eu
# Optional 中国大陆优化 HTTPS image origins; see docs/IMAGE-DOMAINS.md before enabling.
PUBLIC_BASE_ALIASES=
ORIGIN_CERT_DIR=/etc/fujipic/origin

# One default bucket; add other tenants/regions through /admin after startup.
S3_ENDPOINT=https://YOUR_NAMESPACE.compat.objectstorage.ap-tokyo-1.oraclecloud.com
S3_REGION=ap-tokyo-1
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Generate once: openssl rand -base64 32. Back up; do not rotate casually.
STORAGE_ENCRYPTION_KEY=
# Generate separately: openssl rand -hex 32. Also set in the Cloudflare rule.
ORIGIN_SHARED_SECRET=

BOOTSTRAP_ADMIN_EMAIL=
# Generate separately: openssl rand -hex 24. Clear BOTH bootstrap fields later.
BOOTSTRAP_ADMIN_PASSWORD=
CONTACT_EMAIL=
SESSION_TTL=24h

# Optional Turnstile Managed verification; configure all three together.
# Exact website hostname(s), comma-separated; no localhost in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
MAX_IMAGE_DIMENSION=12000
DEFAULT_QUOTA_BYTES=1073741824

# Zone ID for lesliealexander.eu; token limited to that zone, Cache Purge only.
CDN_ZONE_ID=
CDN_PURGE_TOKEN=
