# Origin server. TLS is terminated by the CDN in front of this service.
# If the CDN connects over HTTPS, replace :8080 with your origin domain and
# configure a certificate (or Cloudflare Tunnel / mTLS).
:8080 {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy app:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
