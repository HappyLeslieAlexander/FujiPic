# Copy to .env and adjust. Never commit real secrets.

# production | development
APP_ENV=development
# Public site/API origin (the CDN hostname users and browsers hit).
APP_BASE_URL=http://localhost:8080
# Public image origin (the CDN hostname used in returned image URLs). No path.
PUBLIC_BASE_URL=http://localhost:8080
LISTEN_ADDR=:8080

DATABASE_PATH=./data/fujipic.db
TMP_DIR=./data/tmp

# s3 | memory (memory is for tests/demos only)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fujipic
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
MAX_IMAGE_DIMENSION=12000
DEFAULT_QUOTA_BYTES=1073741824
ALLOW_OPEN_REGISTRATION=false

# Created only when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Public abuse-report contact shown in page footers; empty hides it.
CONTACT_EMAIL=

# CDN / origin protection
TRUST_PROXY=true
CLIENT_IP_HEADER=CF-Connecting-IP
ORIGIN_SHARED_SECRET=
SESSION_TTL=720h

# CDN cache purge: none | cloudflare | generic
CDN_PURGE_PROVIDER=none
# CDN_PURGE_ENDPOINT=
# CDN_PURGE_TOKEN=
# CDN_ZONE_ID=

LOG_LEVEL=info
